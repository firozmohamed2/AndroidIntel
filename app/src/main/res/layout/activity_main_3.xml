<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg"

    android:fitsSystemWindows="true"

    tools:context=".MainActivity">

    <!-- Toolbar with App Name & Profile Icon -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:titleTextColor="#3F51B5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:elevation="1dp"
        app:layout_constraintHeight_default="wrap">

        <TextView
            android:id="@+id/profile_text"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:padding="8dp"
            android:src="@drawable/img"
            android:fontFamily="@font/fs_m"
            android:textSize="17dp"
            android:textFontWeight="600"
            android:textStyle="bold"
            android:text="Plus two science (kerala board) "
            android:textColor="#3B4DB2"
            android:contentDescription="Profile" />
        <ImageView
            android:id="@+id/down_arrow"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="6dp"
            android:src="@drawable/down_arrow"
            android:contentDescription="Profile" />
        <!-- Profile Icon -->
        <ImageView
            android:id="@+id/profile_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:padding="0dp"
            android:layout_margin="4dp"
            android:src="@drawable/profile_2"
            android:contentDescription="Profile" />
    </androidx.appcompat.widget.Toolbar>



    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="10dp"
        android:layout_marginHorizontal="10dp"
        android:id="@id/daily_class_card"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FF0101"
            android:layout_gravity="center_vertical">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/live_img_2"
                android:background="#fff"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="DAILY CLASS"
                android:textColor="#fff"
                />
        </LinearLayout>
    </androidx.cardview.widget.CardView>




        <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:id="@+id/daily_class_card"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <TextView
                android:id="@+id/greeting_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/funnel_sans_bold"
                android:maxLines="2"
                android:lines="2"
                android:ellipsize="end"

                android:text="Good Evening \n Goku"
                android:textSize="35dp"
                android:textFontWeight="700"

                android:textStyle="bold"
                android:textColor="#3B4DB2"
                android:textAppearance="@style/TextAppearance.AppCompat.Body1"
                app:layout_constraintLeft_toLeftOf="parent"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="15dp"
                app:layout_constraintTop_toTopOf="parent" />




        </androidx.constraintlayout.widget.ConstraintLayout>










        <LinearLayout
            android:layout_marginHorizontal="0dp"
            app:layout_constraintTop_toBottomOf="@id/daily_class_card"
            android:layout_marginTop="50dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"
            android:padding="0dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:padding="0dp"
                android:layout_marginTop="0dp">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/mathsCard"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:orientation="vertical">

                    <ImageView

                       style="@style/subject_image_style"
                        android:src="@drawable/math"
                       />

                    <TextView
                        style="@style/subject_text_style"

                        android:text="Maths"

                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/physicsCard"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView

                        android:src="@drawable/physics"
                        style="@style/subject_image_style"
                        />
                    <TextView
                        style="@style/subject_text_style"

                        android:text="Physics"

                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:id="@+id/chemistryCard"
                    android:orientation="vertical">
                    <ImageView

                        android:src="@drawable/chem"
                        style="@style/subject_image_style"
                        />
                    <TextView
                        style="@style/subject_text_style"

                        android:text="Chemistry"

                        />

                </LinearLayout>




            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:padding="0dp"
                android:layout_marginTop="20dp">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/biologyCard"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView

                        android:src="@drawable/bio"
                        style="@style/subject_image_style"
                        />

                    <TextView
                        style="@style/subject_text_style"

                        android:text="Biology"

                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/geoCard"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView
                        style="@style/subject_image_style"

                        android:src="@drawable/civics"
                        />
                    <TextView
                        style="@style/subject_text_style"

                        android:text="Civics"

                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintLeft_toLeftOf="parent"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:id="@+id/pyqCard"
                    android:orientation="vertical">
                    <ImageView
                        style="@style/subject_image_style"
                        android:src="@drawable/geography"
                        />
                    <TextView
                        style="@style/subject_text_style"

                        android:text="Geography"

                        />

                </LinearLayout>




            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="horizontal"
                android:padding="0dp"
                android:layout_marginTop="20dp">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/civics2Card"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView
                        style="@style/subject_image_style"
                        android:src="@drawable/politics"
                       />

                    <TextView
                        style="@style/subject_text_style"

                        android:text="History"

                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:id="@+id/geo2Card"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <ImageView
                        style="@style/subject_image_style"
                        android:src="@drawable/computer"
                       />
                    <TextView
                        style="@style/subject_text_style"
                        android:text="Exam"

                        />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:layout_weight="1"
                    android:id="@+id/pyq2Card"
                    android:orientation="vertical">
                    <ImageView
                        style="@style/subject_image_style"
                        android:src="@drawable/pyq"
                        />
                    <TextView

                        android:text="pyq"
                        style="@style/subject_text_style"

                        />
                </LinearLayout>




            </LinearLayout>


        </LinearLayout>



    <!-- GridLayout for Subjects -->


</androidx.constraintlayout.widget.ConstraintLayout>
